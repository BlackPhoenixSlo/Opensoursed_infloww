{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next/public-check/types/**/*.ts",
    ".next/public-check/dev/types/**/*.ts",
    ".next/slop/types/**/*.ts",
    ".next/slop/dev/types/**/*.ts",
    ".next/slop-s01/types/**/*.ts",
    ".next/slop-s01/dev/types/**/*.ts",
    ".next/slop-s02/types/**/*.ts",
    ".next/slop-s02/dev/types/**/*.ts",
    ".next/slop-s07/types/**/*.ts",
    ".next/slop-s07/dev/types/**/*.ts",
    ".next/slop-prod/types/**/*.ts",
    ".next/slop-prod/dev/types/**/*.ts",
    ".next/demo/types/**/*.ts",
    ".next/demo/dev/types/**/*.ts",
    ".next/fa-owner-test/types/**/*.ts",
    ".next/fa-owner-test/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
