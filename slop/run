#!/usr/bin/env bash
# slop/run <scenario|all> [--scale=small|medium|huge] [--users=N] [--seed=N] [--break] [--no-ui] [--timeout=S] [--set k=v]
#          --changed [--dry] (only the scenarios the diff reaches, slop/map.json) | <target> --map (rebuild it)
#          <args> --share (join an exact live run of this checkout; not with --map/nightly)
#          nightly [--dry] [--phases=all,volume,map] [--smoke] [--detach] [--apply-map=F] (daily full sweep)
# Throwaway loopback stack per scenario; evidence in slop/evidence/<stamp>-<scenario>/ (latest -> newest).
set -euo pipefail
# --share (README "Fast local feedback"): lib/share.py, before the gate: a follower takes no slot and no stack;
# a leader runs this script again without --share, which queues for the gate as usual. Only the flag enables it.
for a in "$@"; do [ "$a" = --share ] && exec python3 "$(dirname "${BASH_SOURCE[0]}")/lib/share.py" "$@"; done
# The machine gate (README "The machine gate"): outside one, re-exec this under ~/.slop/gate.py
# (it sets SLOP_GATED for us). Listings take no lock; a missing gate is lib/cli.py's loud INFRA.
# nightly never holds it: each of its child slop/run's queues for it in turn.
if [ -z "${SLOP_GATED:-}" ] && [ -f "$HOME/.slop/gate.py" ] && [ "${1:-}" != nightly ]; then
  skip=; nw=
  for a in "$@"; do case "$a" in --list|--dry|-h|--help) skip=1;; --no-wait) nw=--no-wait;; esac; done
  # --scale >= medium with --users >= 120 runs alone (lib/gate.py exclusive(); README "The machine gate")
  # A failed pre-check refuses the run, never a downgrade to a non-exclusive one: exit 2 is a usage error
  # (--scale/--users the parser rejects; reason on stderr), any other failure INFRA (exit 3).
  [ -n "$skip" ] || { rc=0; ex=$(python3 "$(dirname "${BASH_SOURCE[0]}")/lib/gate.py" "$@") || rc=$?
    [ "$rc" = 2 ] && exit 2
    [ "$rc" = 0 ] || { echo "slop: INFRA exclusivity pre-check (lib/gate.py) failed (exit $rc): not run" >&2; exit 3; }
    exec python3 "$HOME/.slop/gate.py" run $nw $ex -- "$0" "$@"; }
fi
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# A linked worktree borrows the main checkout's venv and non-app dependencies.
# Next/Turbopack needs app/node_modules inside this worktree, so copy it.
MAIN="$(dirname "$(git -C "$ROOT" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || echo "$ROOT/.git")")"
if [ "$MAIN" != "$ROOT" ]; then
  if [ -d "$MAIN/app/node_modules" ]; then
    nice -n 10 python3 "$ROOT/slop/lib/clone_modules.py" "$MAIN" "$ROOT"
  fi
  for d in venv web/node_modules desktop/node_modules; do
    if [ ! -e "$ROOT/$d" ] && [ ! -L "$ROOT/$d" ] && [ -d "$MAIN/$d" ]; then
      ln -s "$MAIN/$d" "$ROOT/$d" && echo "slop: worktree: linked $d -> $MAIN/$d" >&2
    fi
  done
fi
# nightly as a module, not cli.py: the venv's gate hook re-execs any cli.py run under the gate
[ "${1:-}" = nightly ] && cd "$ROOT" && shift && exec "$ROOT/venv/bin/python" -u -m slop.lib.nightly "$@"
exec "$ROOT/venv/bin/python" -u "$ROOT/slop/lib/cli.py" "$@"
