{
  "note": "One notice shape, three parsers (design.md B3). frame = an SSE frame as the relay emits it (OF pump: __account_* + the OF key; purchase_notified: purchase_notifications._broadcast_purchase). settings = a partial stored NotifSettings over the defaults; expect = the OS notices that pass its per-type gate (enabled && osPing && toast[typeKey]). Canonical source: the app (app/lib/pushNotice.test.ts); consumers: desktop/test/relay-notices.test.js, service/tests/test_push_notice.py.",
  "cases": [
    {
      "name": "inbound DM (message toast on)",
      "settings": {
        "toast": {
          "message": true
        }
      },
      "frame": {
        "__account_id": "100",
        "__account_name": "Creator One",
        "__account_color": "#e91e63",
        "api2_chat_message": {
          "id": 5001,
          "text": "<p>hey <b>you</b></p>",
          "price": 0,
          "isFree": true,
          "isOpened": false,
          "isTip": false,
          "mediaCount": 0,
          "media": [],
          "responseType": "message",
          "fromUser": {
            "id": 777,
            "username": "fanboy",
            "name": "Fan Boy"
          },
          "createdAt": "2026-11-03T10:00:00.000Z"
        }
      },
      "expect": [
        {
          "id": "100:m5001",
          "typeKey": "message",
          "title": "Fan Boy",
          "body": "hey you",
          "href": "/messages-pro/100/777?fanTab=Fan+Boy"
        }
      ]
    },
