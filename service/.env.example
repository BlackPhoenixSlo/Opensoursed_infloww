# Copy to service/.env (gitignored). Fill values per environment.

# Relay share-link gate. Bare `docker compose up` uses the default below if unset.
# Generate a fresh one with: openssl rand -hex 24
SHARE_TOKEN=

# Second factor on founder-only writes: granting/revoking a model, transferring
# one, deleting a user, and setting another agency's AI keys. UNSET = every one
# of those answers 503, so the founder surface is simply dead.
#
# CONTAINER DEPLOYS DO NOT READ THIS FILE. It is not in the image (the
# Dockerfile COPY is a .py allow-list) and it is not mounted, so put
# ADMIN_PASSWORD in the compose-level .env instead — docker-compose.yml
# forwards it through the relay's `environment:` block. This file is read by a
# native scripts/start.sh run.
#
# Wherever it comes from, the ENVIRONMENT outranks the Setup -> Server keys
# store for this one key. That is what makes rotation work at all: the store can
# bootstrap the first password and refuses to change it, so if the store won
# there would be no way to replace one.
ADMIN_PASSWORD=

# SQLAlchemy connection string.
# SQLite default — phase A. Switch to postgresql+asyncpg://... when you scale.
DATABASE_URL=sqlite+aiosqlite:///./service/chatterly.db

# LLM provider keys for service/llm_client.py (providers in service/llm_providers.py).
# Setup -> Keys can hold them too. A blank value only disables that provider.
DEEPSEEK_API_KEY=
# Vision (Qwen3-VL) for the vault describe pass.
DEEPINFRA_API_KEY=
# Z.ai (GLM): only for an account an operator has pointed at it.
ZAI_API_KEY=

# OnlyFans egress proxy pool (see docs/proxies.md). Comma-separated, any of:
#   host:port:user:pass   user:pass@host:port   socks5://host:port
# Single-quote the value if a password contains `$`. Containers read it from the
# compose-level .env (docker-compose.yml forwards it to the relay).
INFLOWW_PROXIES=

# Public site (web/) URL: the app's "Back to the site" links and the one origin
# allowed to post its login/signup forms. Compose-level .env; empty =
# https://inflowwww.com. Rebuild the app container after changing it.
SITE_URL=

# SECRETS: DEEPSEEK_API_KEY and INFLOWW_PROXIES hold real credentials. Fill
# them only in an untracked .env on the host that runs the stack; never commit
# a filled copy of this file.
