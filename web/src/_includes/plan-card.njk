{#- One Inflowwww plan card per platform, one per platform like infloww.com/pricing.
    Set `planId` (onlyfans | fansly | mym | fanvue, default onlyfans) and `planHeading` (default h3)
    before the include. Set `planTos = true` to print the OnlyFans Terms of Service line in the
    OnlyFans card, and `planCompact = true` to fold the feature lists into a <details> so the four
    cards on /pricing/ stay the same height (/pricing/ sets both). The CTA sits at the bottom of
    every card. Claims come only from README.md and docs/routes.md. -#}
{%- set plans = {
  onlyfans: {
    name: "OnlyFans",
    status: "Built",
    summary: "Built. It works through each creator's OnlyFans login, captured once, and makes the same calls the website does.",
    cta: { label: "Open the repository", href: site.repo },
    included: [
      { label: "Messages Pro, with a fan insights rail for notes", route: "/messages-pro" },
      { label: "Smart lists", route: "/growth/smart-lists" },
      { label: "Smart Messages", route: "/growth/smart-messages" },
      { label: "Vault Pro: the owner sorts it; chatters attach media from the chat composer", route: "/growth/vault-pro" },
      { label: "Message dashboard", route: "/analytics/message-dashboard" },
      { label: "Creator, Employee and Fan reports", route: "/analytics/creator-reports, /analytics/employee-reports, /analytics/fan-reports" },
      { label: "Scripts", route: "/growth/scripts" },
      { label: "Auto Post and Auto Story", route: "/growth/auto-post, /growth/auto-story" },
      { label: "Custom proxy", route: "/creators/proxy" },
      { label: "Manage employees", route: "/employees" },
      { label: "Team logins: a share token for the dashboard plus per-user logins: the owner at /login, each chatter at /chatter-login", route: "/login, /chatter-login" }
    ],
    missing: [
      { label: "No AI Copilot." },
      { label: "Shift schedule", note: "NotBuiltYet" },
      { label: "OF Manager, 12 sections", note: "NotBuiltYet" }
    ],
    empty: ""
  },
  fansly: {
    name: "Fansly",
    status: "NotBuiltYet",
    summary: "A Fansly client lives in the repo; the Docker image (a packaged copy of the app) does not ship it yet.",
    cta: { label: "Read fansly/", href: site.repo ~ "/tree/main/fansly" },
    included: [
      { label: "The Fansly client, in the repository", route: "fansly/" },
      { label: "Session capture (signing in to Fansly once in Chrome so the relay can act on the account) with the Chrome extension", route: "loginExtensionMulti/" }
    ],
    missing: [],
    empty: "In plain words: the code is started, but the version you install can't connect to Fansly yet. The Creators page already shows a Connect Fansly card; on the Docker install it doesn't work yet, so skip it."
  },
  mym: {
    name: "mym",
    status: "Not built",
    summary: "Not built: there is no client; the card exists because theirs does.",
    cta: { label: "Open an issue", href: site.repo ~ "/issues" },
    included: [],
    missing: [],
    empty: "Nothing yet. The repository has no mym client, so no screen talks to mym."
  },
  fanvue: {
    name: "Fanvue",
    status: "Not built",
    summary: "Not built: no Fanvue client either, and the card is here for the same reason.",
    cta: { label: "Open an issue", href: site.repo ~ "/issues" },
    included: [],
    missing: [],
    empty: "Nothing yet. The repository has no Fanvue client, so no screen talks to Fanvue."
  }
} -%}
{%- set pid = planId or "onlyfans" -%}
{%- set plan = plans[pid] -%}
{%- set hTag = planHeading or "h3" -%}
{%- set lists %}
  {%- if plan.included | length %}
  <p class="{{ 'mt-3' if planCompact else 'mt-6' }} text-sm font-medium text-ink">Included, with the route:</p>
  <ul class="mt-3 space-y-2 text-sm text-ink">
    {%- for item in plan.included %}
    <li class="flex gap-2"><svg class="mt-0.5 size-4 shrink-0 text-forest" aria-hidden="true" focusable="false"><use href="#i-check" /></svg><span class="min-w-0">{{ item.label }} <code class="block text-xs break-words text-muted">{{ item.route }}</code></span></li>
    {%- endfor %}
  </ul>
  {%- endif %}
  {%- if plan.missing | length %}
  <p class="mt-6 text-sm font-medium text-ink">Not included:</p>
  <ul class="mt-3 space-y-2 text-sm text-ink">
    {%- for item in plan.missing %}
    <li class="flex gap-2"><svg class="mt-0.5 size-4 shrink-0 text-muted" aria-hidden="true" focusable="false"><use href="#i-x" /></svg><span class="min-w-0 break-words">{{ item.label }}{{ ": " ~ item.note if item.note }}</span></li>
    {%- endfor %}
  </ul>
  {%- endif %}
{%- endset %}
{#- The heading reads "Inflowwww for OnlyFans"; the platform sits on its own line, so all four titles are one line and the $0 lines align. -#}
<article class="card flex h-full flex-col bg-white ring-1 ring-black/10" aria-labelledby="plan-{{ pid }}-title">
  <div class="flex flex-wrap items-start justify-between gap-2">
    <{{ hTag }} id="plan-{{ pid }}-title" class="text-lg font-semibold text-ink"><span class="block text-sm font-normal text-muted">Inflowwww for</span> {{ plan.name }}</{{ hTag }}>
    <span class="status-chip" data-status="{{ plan.status }}">{{ plan.status }}</span>
  </div>
  <p class="mt-1 text-sm text-muted">Per creator profile, per month</p>
  <p class="mt-4 text-5xl font-semibold tracking-tight text-ink">$0</p>
  <p class="mt-1 text-sm text-muted">Billed never</p>
  <p class="mt-4 text-ink">{{ plan.summary }}</p>
  {#- The plain-words note is its own muted paragraph above the details, so it never reads as their content. -#}
  {%- if plan.empty %}
  <p class="mt-3 text-sm text-muted">{{ plan.empty }}</p>
  {%- endif %}
  {%- if planCompact and (plan.included | length or plan.missing | length) %}
  <details class="group mt-6 border-t border-line pt-4">
    <summary class="flex min-h-11 cursor-pointer items-center justify-between gap-4 text-sm font-medium text-ink">
      <span>What's included<span class="sr-only"> for {{ plan.name }}</span></span>
      <svg class="size-4 shrink-0 text-muted group-open:rotate-45 motion-safe:transition-transform" aria-hidden="true" focusable="false"><use href="#i-plus" /></svg>
    </summary>
    {{ lists | safe }}
  </details>
  {%- else %}
  {{ lists | safe }}
  {%- endif %}
  <div class="mt-auto pt-6">
    {%- if planTos and pid == "onlyfans" %}
    <p class="mb-6 border-t border-line pt-4 text-sm text-ink">{% include "tos.njk" %}</p>
    {%- endif %}
    <a class="{{ 'btn-primary' if plan.status == 'Built' else 'btn-secondary' }} w-full" href="{{ plan.cta.href }}">{{ plan.cta.label }}</a>
  </div>
</article>
