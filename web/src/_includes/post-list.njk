{#- The post card grid, then an optional pager.
    Expects `posts`. Set `compact` for the "Start here" row list instead (one row per post: title, then
    the label and reading time; it sits under a bucket heading, so it skips the bucket name; `phoneRows`
    caps the rows shown below `sm`) and
    `cardHeading` to the card title's heading level (default 3; the including page supplies the level above).
    For the pager, set `pagerHrefs` (one unprefixed URL per page),
    `pagerIndex` (0-based current page) and `pagerLabel` (the nav's aria-label).
    Every card ends on one meta line: Parody badge or "Straight advice", then bucket and reading time. -#}
{%- set level = cardHeading or 3 %}
{%- if compact %}
<ol class="mt-4 divide-y divide-line border-y border-line">
  {%- for post in posts %}
  <li class="flex flex-col gap-1 py-3 sm:flex-row sm:items-center sm:justify-between sm:gap-6{% if phoneRows and loop.index > phoneRows %} max-sm:hidden{% endif %}">
    <a class="inline-flex min-h-11 items-center font-medium text-ink hover:underline hover:underline-offset-4" href="{{ post.url | url }}">{{ post.data.title }}</a>
    <span class="flex shrink-0 flex-wrap items-center gap-x-2 text-sm text-muted">
      {%- if post.data.straight %}
      <span class="badge-straight">Straight advice</span>
      {%- elif post.data.parodyOf %}
      <span class="badge-parody">Parody</span>
      {%- endif %}
      <span>{{ post.content | readingTime }}</span>
    </span>
  </li>
  {%- endfor %}
</ol>
{%- else %}
<ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
  {%- for post in posts %}
  {%- set bucket = post.data.tags | bucketFor %}
  <li class="relative flex flex-col rounded-2xl bg-white p-6 ring-1 ring-black/10 hover:bg-cream motion-safe:transition-colors">
    <h{{ level }} class="text-lg font-semibold tracking-tight text-balance">
      <a class="after:absolute after:inset-0 after:rounded-2xl hover:underline hover:underline-offset-4" href="{{ post.url | url }}">{{ post.data.title }}</a>
    </h{{ level }}>
    {%- if post.data.description %}
    <p class="mt-2 line-clamp-3 text-sm text-muted">{{ post.data.description }}</p>
    {%- endif %}
    <p class="mt-auto flex flex-wrap items-center gap-x-2 gap-y-1 pt-4 text-sm text-muted">
      {%- if post.data.straight %}
      <span class="badge-straight">Straight advice</span>
      {%- elif post.data.parodyOf %}
      <span class="badge-parody">Parody</span>
      {%- endif %}
      <span>{% if bucket %}{{ bucket.label }} · {% endif %}{{ post.content | readingTime }}</span>
    </p>
  </li>
  {%- endfor %}
</ul>
{%- endif %}
{%- if pagerHrefs and pagerHrefs.length > 1 %}
<nav aria-label="{{ pagerLabel or 'Pages' }}" class="mt-12 flex flex-wrap items-center justify-center gap-2">
  {%- if pagerIndex > 0 %}
  <a class="btn-secondary" href="{{ pagerHrefs[pagerIndex - 1] | url }}" rel="prev">Previous</a>
  {%- endif %}
  <ol class="flex flex-wrap items-center gap-1">
    {%- for href in pagerHrefs %}
    <li>
      {%- if loop.index0 == pagerIndex %}
      <a class="inline-flex size-11 items-center justify-center rounded-full border-2 border-transparent bg-ink text-sm font-medium text-white underline underline-offset-4" href="{{ href | url }}" aria-current="page"><span class="sr-only">Page </span>{{ loop.index }}</a>
      {%- else %}
      <a class="inline-flex size-11 items-center justify-center rounded-full text-sm font-medium text-ink hover:bg-band" href="{{ href | url }}"><span class="sr-only">Page </span>{{ loop.index }}</a>
      {%- endif %}
    </li>
    {%- endfor %}
  </ol>
  {%- if pagerIndex < pagerHrefs.length - 1 %}
  <a class="btn-secondary" href="{{ pagerHrefs[pagerIndex + 1] | url }}" rel="next">Next</a>
  {%- endif %}
</nav>
{%- endif %}
